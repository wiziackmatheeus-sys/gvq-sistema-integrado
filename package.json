{
  "name": "gvq-sistema-integrado",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/fluxo.test.mjs tests/rascunho.test.mjs tests/envio.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-gvq-tests --only firestore 'node --test tests/firestore.test.mjs'",
    "test:browser": "node tests/browser.cjs",
    "test:storage": "firebase emulators:exec --project demo-gvq-tests --only firestore,storage 'node --test tests/storage.test.mjs'",
    "test:contas": "firebase emulators:exec --project demo-gvq-tests --only auth,firestore 'node --test tests/contas.test.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "13.6.0",
    "firebase-tools": "14.27.0",
    "playwright": "1.62.1"
  }
}

